{
  "name": "@cloudgatedevs/cloudgate-client-react",
  "version": "0.1.10",
  "description": "Complete Cloudgate React SDK with back office, native platform APIs, authentication, widgets, themes and developer tools.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    },
    "./platform": {
      "types": "./platform.d.ts",
      "default": "./src/platform/index.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "default": "./dist/react/index.js"
    },
    "./react/styles.css": "./dist/react/styles.css",
    "./react/widgets": {
      "types": "./widgets.d.ts",
      "default": "./dist/react/widgets.js"
    },
    "./widgets/catalog": {
      "types": "./src/widgets/catalog.d.ts",
      "default": "./src/widgets/catalog.js"
    },
    "./widgets/manifest": "./src/widgets/picker-manifest.json",
    "./tailwind": "./tailwind.preset.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "dist/",
    "index.d.ts",
    "platform.d.ts",
    "react.d.ts",
    "widgets.d.ts",
    "docs/widgets.md",
    "tailwind.preset.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build"
  },
  "bin": {
    "cloudgate-widgets": "./src/widgets/cli.mjs",
    "cloudgate-widgets-mcp": "./src/widgets/mcp.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "cloudgate",
    "api",
    "gateway",
    "hmac",
    "sdk",
    "client",
    "workflow",
    "websocket",
    "realtime",
    "react",
    "backoffice",
    "widgets",
    "cloudgate-react"
  ],
  "author": "Cloudgate Devs (https://cloudgate.dev)",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "dependencies": {
    "@ckeditor/ckeditor5-react": "11.1.2",
    "@cloudgatedevs/cloudgate-client": "^0.7.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/view": "^6.43.13",
    "@dnd-kit/core": "6.3.1",
    "@fullcalendar/react": "7.1.0",
    "@lezer/highlight": "^1.2.4",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "@uiw/react-codemirror": "^4.25.12",
    "@uppy/core": "4.5.3",
    "@uppy/dashboard": "4.3.3",
    "@uppy/react": "4.2.3",
    "@uppy/webcam": "4.1.2",
    "ckeditor5": "48.1.1",
    "dompurify": "3.4.16",
    "echarts": "^6.1.0",
    "react-easy-crop": "5.5.7",
    "temporal-polyfill": "1.0.5",
    "write-excel-file": "^4.1.1"
  },
  "peerDependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "lucide-react": "^1.41.0",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.5.4",
    "esbuild": "0.21.5",
    "jsdom": "30.1.1",
    "lucide-react": "1.47.0",
    "postcss": "8.5.26",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "react-test-renderer": "18.3.1",
    "tailwindcss": "3.4.19"
  }
}
